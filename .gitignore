# Dependencies
/vendor/
/node_modules/

# Environment and credentials
.env
.env.*
!.env.example
!.env.testing.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# PHP tooling
/.phpunit.cache/
/coverage/
/build/
/dist/

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Runtime storage: never commit patient data, signatures, logs, uploads, or locks
/storage/app/*
!/storage/app/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
/storage/private/*
!/storage/private/.gitkeep

# Legacy/private intake runtime paths, if retained during migration
/app_private/storage/signatures/
/app_private/storage/uploads/
/app_private/storage/logs/
/app_private/storage/idempotency/
/app_private/storage/*.log
/app_private/storage/*.json
/app_private/.env

# Database exports and backups
*.sql
*.sql.gz
*.dump
*.bak
*.sqlite
*.sqlite3
/database/exports/
/backups/

# Frontend build artifacts
/.next/
/out/
/vite.config.*.timestamp-*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
