{
    "name": "maz/dashboard-backend",
    "description": "dashboard.drbastaninejad.com PHP 8.x MVC backend — MΛZ Medical CRM",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
