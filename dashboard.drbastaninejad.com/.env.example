APP_ENV=production
DEFAULT_CLINIC_ID=1
CLINIC_TIMEZONE=Asia/Tehran
SYSTEM_TENANT_ID=1

DB_HOST=localhost
DB_NAME=CHANGE_ME
DB_USER=CHANGE_ME
DB_PASS=CHANGE_ME

WORDPRESS_BRIDGE_SECRET=CHANGE_ME_LONG_RANDOM
INTAKE_BRIDGE_SECRET=CHANGE_ME_LONG_RANDOM
BOOKING_SMS_SECRET=CHANGE_ME_LONG_RANDOM

BOOKING_SMS_ENABLED=1
