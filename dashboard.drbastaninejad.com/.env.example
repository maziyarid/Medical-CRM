# Leave empty to auto-detect from credentials. Example: tsms,kavenegar
SMS_PROVIDERS=
TSMS_USERNAME=
TSMS_PASSWORD=
TSMS_FROM=
TSMS_URL=https://www.tsms.ir/tsms/wsrv.ashx
