FARAZSMS_PASSWORD=
FARAZSMS_FROM=

OTP_MAX_ATTEMPTS=5
OTP_IP_MAX_ATTEMPTS=8
OTP_GLOBAL_MAX_PER_MINUTE=30
TRUSTED_PROXY_IPS=
