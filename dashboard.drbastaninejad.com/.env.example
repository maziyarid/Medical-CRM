APP_ENV=production
DEFAULT_CLINIC_ID=1
CLINIC_TIMEZONE=Asia/Tehran
SYSTEM_TENANT_ID=1

DB_HOST=localhost
DB_NAME=CHANGE_ME
DB_USER=CHANGE_ME
DB_PASS=CHANGE_ME

WORDPRESS_BRIDGE_SECRET=CHANGE_ME_LONG_RANDOM
INTAKE_BRIDGE_SECRET=CHANGE_ME_LONG_RANDOM

BOOKING_SMS_ENABLED=1
BOOKING_COOLDOWN_MINUTES=30
PATIENT_LOGIN_URL=https://app.drbastaninejad.com/Frontend/pages/auth/patient-login.html
BOOKING_SMS_TEMPLATE=درخواست نوبت شما دریافت شد؛ زمان نوبت هنوز قطعی نیست. همکاران کلینیک برای اعلام و تأیید زمان تماس می‌گیرند. پنل بیمار: {login_url}
BOOKING_EMAIL_ENABLED=1
MAIL_FROM=
BOOKING_SHEET_WRITE_ENABLED=1
BOOKING_SHEET_WEBHOOK_URL=
BOOKING_SHEET_SHARED_SECRET=CHANGE_ME_LONG_RANDOM
BOOKING_VISIT_SHEET_NAME=ScheduledVisits
BOOKING_SHEET_SYNC_BATCH_SIZE=25

# Leave empty to auto-detect from credentials. Example: tsms,kavenegar
SMS_PROVIDERS=
TSMS_USERNAME=
TSMS_PASSWORD=
TSMS_FROM=
TSMS_URL=https://www.tsms.ir/tsms/wsrv.ashx
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
GHASEDAK_API_KEY=
FARAZSMS_USERNAME=
FARAZSMS_PASSWORD=
FARAZSMS_FROM=

OTP_MAX_ATTEMPTS=5
OTP_IP_MAX_ATTEMPTS=8
OTP_GLOBAL_MAX_PER_MINUTE=30
TRUSTED_PROXY_IPS=
MAX_BODY_BYTES=65536

# Appointment booking v2. Values remain server-side; never expose gateway secrets to the browser.
BOOKING_HOLD_MINUTES=15
BOOKING_APPOINTMENT_DEPOSIT_RIALS=
BOOKING_PAYMENT_GATEWAYS=zarinpal,vandar
BOOKING_PAYMENT_CALLBACK_BASE=https://dashboard.drbastaninejad.com/api/v1/appointment-bookings/payment/callback
BOOKING_PAYMENT_RETURN_URL=https://drbastaninejad.com/booking/
BOOKING_DEFAULT_PROVIDER_ID=

# Zarinpal payment gateway.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=0

# Vandar payment gateway.
VANDAR_API_TOKEN=
VANDAR_SANDBOX=0

# Google Calendar OAuth bridge used by the clinic DevExpress Scheduler.
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
CALENDAR_SYNC_BATCH_SIZE=25

# Staff onboarding / portal
STAFF_LOGIN_URL=https://app.drbastaninejad.com/Frontend/pages/auth/login.html

# Local Google bridge (preferred on this VPS; token is server-generated, never commit real value)
GOOGLE_BRIDGE_URL=http://127.0.0.1:9118
GOOGLE_BRIDGE_TOKEN=
BOOKING_SHEET_BRIDGE_URL=http://127.0.0.1:9118
BOOKING_SHEET_BRIDGE_TOKEN=
BOOKING_VISIT_SHEET_NAME=ScheduledVisits
