# dashboard.drbastaninejad.com — production environment template
# Copy to .env OUTSIDE the public/ document root, chmod 600, and replace CHANGE_ME values.
# Never commit real credentials or bridge secrets.

APP_ENV=production

# MySQL/MariaDB — database/user supplied by product owner
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=drbastaninejad_dash
DB_USER=drbastaninejad_dash
DB_PASS=T#.}3R?tQt7drVXl
DEFAULT_CLINIC_ID=1

# Canonical patient login URL.
# Keep this app-host route until the canonical Frontend patient UI is actually mapped to dashboard.drbastaninejad.com.
# Then change only this variable to https://dashboard.drbastaninejad.com/
PATIENT_LOGIN_URL=https://app.drbastaninejad.com/Frontend/pages/auth/patient-login.html

# WorkingVersion -> dashboard intake bridge. Must match the runtime secret on the live intake host.
INTAKE_BRIDGE_SECRET=M_A_Z_I_Y_A_R
INTAKE_SUCCESS_SMS_ENABLED=1
INTAKE_SUCCESS_SMS_TEMPLATE="پرونده شما ثبت شد. برای ورود به پنل بیمار: {login_url} با همان شماره موبایل کد یکبارمصرف دریافت کنید."

# WordPress -> dashboard booking bridge. Never expose this value to browser JavaScript.
WORDPRESS_BRIDGE_SECRET=M_A_Z_I_Y_A_R
BOOKING_COOLDOWN_MINUTES=30
BOOKING_SMS_ENABLED=1
BOOKING_SMS_TEMPLATE="درخواست نوبت شما ثبت شد. همکاران کلینیک برای هماهنگی تماس می‌گیرند. پنل بیمار: {login_url}"

# Dashboard should not duplicate the WorkingVersion Sheet write by default.
DASHBOARD_SHEETS_WRITE_ENABLED=0
# Only needed if DASHBOARD_SHEETS_WRITE_ENABLED=1 for an explicit future integration.
SHEET_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbwVmXOjyVhxbqC955QHzNQUGlzmPa4AyS1F4Nsyg4ADWkb7UDMAXDphTUoP3Z6SQ9cVYw/exec
SHEET_SHARED_SECRET=M_A_Z_I_Y_A_R

# SMS providers — tried in order. "log" is ignored in production.
SMS_PROVIDER=tsms
TSMS_API_URL=http://tsms.ir/url/tsmshttp.php
TSMS_USERNAME=drbastani
TSMS_PASSWORD=123456788
TSMS_FROM=3000667730

# TSMS query parameter names (per official document), for reference in the SMS driver/service:
# Send:    ?from=$from&to=$to&username=$username&password=$password&message=$text
# Credit:  ?from=$from&username=$username&password=$password&credit=what
# Status:  ?from=$from&username=$username&password=$password&deliver=$smsid
TSMS_SEND_PARAM=message
TSMS_CREDIT_PARAM=credit
TSMS_STATUS_PARAM=deliver

SMS_OTP_LENGTH=5
SMS_OTP_TTL_SECONDS=180
SMS_MESSAGE_TEMPLATE="کد تشکیل پرونده: {{code}}\n@app.drbastaninejad.com #{{code}}"
OTP_MAX_ATTEMPTS=5
OTP_PHONE_LIMIT_10_MIN=3
OTP_IP_LIMIT_60_MIN=10


# OTP recovery email. Passwords are never sent; only OTPs are sent.
EMAIL_OTP_ENABLED=1
MAIL_FROM=no-reply@drbastaninejad.com

# Appointment reminders
SMS_REMINDER_OFFSETS=60,1440
EMAIL_REMINDER_ENABLED=1

# ─── AI ───────────────────────────────────────────────
# Keep AI_ENABLED=0 until keys are set and policy approved.
AI_ENABLED=1
# Must be 1 before any clinical/patient text is sent to a provider.
AI_ALLOW_CLINICAL_TEXT=0
# auto | you | openrouter
AI_PROVIDER=auto
AI_MAX_TOKENS=600

# You.com (https://docs.you.com/) — web search + grounded answers
# Get key: https://you.com/platform  (header: X-API-Key)
YOU_API_KEY=ydc-sk-746f3faae7c27dee-ILjVI09fqLHCfcqC56oO3tiZRV9pzr0B-083fa025
# Alias accepted by code:
YDC_API_KEY=

# OpenRouter — optional pure LLM drafts
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=https://dashboard.drbastaninejad.com

