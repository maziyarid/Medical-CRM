# dashboard.drbastaninejad.com — Test environment variables
# Copy to .env.testing for local PHPUnit runs.
# NEVER commit real credentials. DB_NAME must NOT be the production database.
#
# Sample test database name: mazcrm_test
# Run migrations against mazcrm_test before running tests:
#   mysql -u mazcrm_test_user -p mazcrm_test < database/migrations/001_*.sql
#   ... (all migrations in order)

APP_ENV=testing

# ── Test database ─────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mazcrm_test
DB_USER=mazcrm_test_user
DB_PASS=REPLACE_WITH_TEST_PASSWORD

DEFAULT_CLINIC_ID=1

# ── SMS — log provider only in tests (no real SMS sent) ──────────────────────
SMS_PROVIDERS=log

# ── Google Sheets — disabled in tests ────────────────────────────────────────
GOOGLE_SHEET_ID=
GOOGLE_SA_KEY_PATH=

# ── CDN — leave empty in tests ────────────────────────────────────────────────
CDN_BASE_URL=
