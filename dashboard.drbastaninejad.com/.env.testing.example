# dashboard.drbastaninejad.com — Test Environment
# Copy to .env.testing and fill in real test DB credentials.
# NEVER commit .env.testing (it is gitignored).
#
# Run tests:
#   cd dashboard.drbastaninejad.com
#   composer install
#   ./vendor/bin/phpunit --testsuite Unit          # no DB required
#   ./vendor/bin/phpunit --testsuite Integration   # requires DB below
#
# Migrations to apply to mazcrm_test before Integration tests:
#   001 intakes, 002 otp_codes, 003 auth_tokens (app backend — shared DB)
#   008 invoices, 009 tasks
#   010 clinics, 011 appointments, 012 users/roles, 013 emr, 014 auth_tokens

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mazcrm_test
DB_USER=mazcrm_test_user
DB_PASS=REPLACE_WITH_TEST_PASSWORD

APP_ENV=testing
DEFAULT_CLINIC_ID=1
