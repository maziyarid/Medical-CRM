# .env.testing — test database credentials for PHPUnit runs
# NEVER commit real credentials here. Use a dedicated maz_test database.
# Copy this file to .env.testing and fill in your local test values.
# This file is listed in .gitignore and must NOT be committed.

APP_ENV=testing

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=maz_test
DB_USERNAME=maz_test_user
DB_PASSWORD=REPLACE_WITH_TEST_PASSWORD

DEFAULT_CLINIC_ID=1

# OTP / SMS — use log provider in tests (no real SMS sent)
SMS_PROVIDER=log
OTP_EXPIRY_SECONDS=300

# CDN — leave empty in tests (signed_url will be null in documents endpoint)
CDN_BASE_URL=
