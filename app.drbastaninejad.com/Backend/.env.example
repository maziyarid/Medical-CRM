# app.drbastaninejad.com — Environment Variables
# Copy to .env and fill in values. NEVER commit .env.

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=production          # production | development | staging

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=medical_crm
DB_USER=crm_user
DB_PASS=

# ── Clinic ───────────────────────────────────────────────────────────────────
DEFAULT_CLINIC_ID=1

# ── Google Sheets dual-write ─────────────────────────────────────────────────
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Intakes
GOOGLE_SA_KEY_PATH=/home/USER/sa-key.json    # OUTSIDE web root

# ── SMS providers (comma-separated, tried in order) ──────────────────────────
# Available: kavenegar, ghasedak, farazsms, tsms, log
SMS_PROVIDERS=kavenegar,ghasedak,farazsms,tsms

KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

GHASEDAK_API_KEY=
GHASEDAK_TEMPLATE=verify
GHASEDAK_LINE=

FARAZSMS_USERNAME=
FARAZSMS_PASSWORD=
FARAZSMS_FROM=

TSMS_USERNAME=
TSMS_PASSWORD=
TSMS_FROM=
