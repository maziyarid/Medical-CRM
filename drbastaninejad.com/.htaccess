Options -Indexes
RewriteEngine On

# ── 0. Keep real files / directories (assets, fonts, images, css, js) ────────
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ── 1. Redirect *.html URLs to clean path (301 permanent) ────────────────────
# /about.html   → /about
# /blog/post.html → /blog/post
# Skips root index.html (handled by DirectoryIndex below)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# ── 2. Serve clean path from corresponding .html file ────────────────────────
# /about        → about.html
# /gallery      → gallery.html
# /services/rhinoplasty-primary → services/rhinoplasty-primary.html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# ── 3. DirectoryIndex fallback — / serves index.html ─────────────────────────
DirectoryIndex index.html

# ── Security hardening ────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Static asset caching ──────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css              "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp            "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 year"
  ExpiresByType font/woff2            "access plus 1 year"
  ExpiresByType text/html             "access plus 1 hour"
</IfModule>
