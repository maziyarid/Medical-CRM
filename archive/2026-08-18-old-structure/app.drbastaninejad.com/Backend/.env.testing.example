# app.drbastaninejad.com — Test environment variables
# Copy to .env.testing for local PHPUnit runs.
# NEVER commit real credentials. DB_DATABASE must NOT be the production database.
#
# Sample test database name: mazcrm_test
# Sample test user:           mazcrm_test_user
#
# Run migrations against the test DB before running tests:
#   mysql -u mazcrm_test_user -p mazcrm_test < database/migrations/001_create_intakes_table.sql
#   ... (all 9 migrations in order)
#
# Run tests:
#   cd app.drbastaninejad.com/Backend
#   ./vendor/bin/phpunit                          # all suites
#   ./vendor/bin/phpunit --testsuite Unit         # unit only (most tests — DB-free where noted)
#   ./vendor/bin/phpunit --testsuite Integration  # integration (requires DB)
#   ./vendor/bin/phpunit --group outcome_states   # intake lifecycle state tests only

APP_ENV=testing

# ── Test database ─────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mazcrm_test
DB_USER=mazcrm_test_user
DB_PASS=REPLACE_WITH_TEST_PASSWORD

# Legacy key names also accepted by test bootstrap (kept for compatibility)
DB_DATABASE=mazcrm_test
DB_USERNAME=mazcrm_test_user
DB_PASSWORD=REPLACE_WITH_TEST_PASSWORD

DEFAULT_CLINIC_ID=1

# ── OTP / SMS — use log provider only; no real SMS sent ──────────────────────
SMS_PROVIDERS=log
OTP_EXPIRY_SECONDS=300

# ── Google Sheets — disabled in tests ────────────────────────────────────────
GOOGLE_SHEET_ID=
GOOGLE_SA_KEY_PATH=

# ── CDN — leave empty in tests ────────────────────────────────────────────────
# signed_url will be null in documents endpoint when CDN_BASE_URL is unset.
CDN_BASE_URL=
